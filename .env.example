# ─── Core ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://velora:velora@localhost:5432/velora?schema=public"
# Public base URL (used for OAuth/payment callbacks, sitemap, emails)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── Google OAuth (optional; button is hidden when unset) ───────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Paystack (required to accept online payments) ──────────────────────
# Without a key checkout still creates orders, but they stay "Awaiting Payment"
# and the page explains that online payment is unavailable. Nothing is faked.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Currency the gateway charges in (Paystack supports NGN, GHS, ZAR, KES, USD)
PAYMENT_CURRENCY="NGN"

# ─── Email (Resend). Without a key emails are written to the server log ──
RESEND_API_KEY=""
EMAIL_FROM="VELORA <no-reply@velora.example>"

# ─── Cloudinary (admin image uploads). Without it, admins add image URLs ─
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── WhatsApp & contact ─────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="2349034824292"
NEXT_PUBLIC_SUPPORT_EMAIL="concierge@velora.example"
NEXT_PUBLIC_SUPPORT_PHONE="+234 903 482 4292"

# ─── Seed admin account (prisma db seed) ────────────────────────────────
SEED_ADMIN_EMAIL="yousuph15@gmail.com"
SEED_ADMIN_PASSWORD="Velora!Admin2026"
